# LLM (any OpenAI-compatible endpoint). Leave the key empty to run in offline mode.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5

# Optional: ClickUp personal token (Settings > Apps in ClickUp). Can also be set in the dashboard.
CLICKUP_TOKEN=

# Optional: Google Meet OAuth access token with meetings.space.readonly scope.
GOOGLE_ACCESS_TOKEN=

# Where the SQLite database lives
STAFFROOM_DB=data/staffroom.db
